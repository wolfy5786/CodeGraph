# Root of the directory tree you want to ingest from.
# This entire directory is bind-mounted into the backend container at /repos (read-only).
# The backend translates host paths to /repos/... internally, so you can type normal paths in the UI.
#
# Windows example: REPOS_ROOT=D:\SanJose
# macOS/Linux example: REPOS_ROOT=/home/yourname/projects
REPOS_ROOT=

# Stable AES-GCM key for the bundled FalkorDB Browser (hex, 32 bytes).
# Generate with: openssl rand -hex 32
# Silences the "Failed to resolve connection password (non-fatal)" decryption error.
FALKOR_BROWSER_ENCRYPTION_KEY=
