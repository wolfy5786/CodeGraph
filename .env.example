# Stable AES-GCM key for the bundled FalkorDB Browser (hex, 32 bytes).
# Generate with: openssl rand -hex 32
# Silences the "Failed to resolve connection password (non-fatal)" decryption error.
FALKOR_BROWSER_ENCRYPTION_KEY=

# Optional backend overrides (defaults shown). The backend runs natively on the
# host and connects to the FalkorDB container on localhost.
# FALKOR_HOST=127.0.0.1
# FALKOR_PORT=6379
# API_HOST=127.0.0.1
# API_PORT=8765
